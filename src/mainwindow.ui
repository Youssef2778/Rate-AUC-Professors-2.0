       <property name="styleSheet">
        <string notr="true">QWidget#page_3 {
    border-image: url(:/images/Background.jpg);
}
/* General font (optional but nicer) */
QWidget {
    font-family: Segoe UI;
    font-size: 24px;
}
/* QPushButton */
QPushButton {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    color: white;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.5);
}
QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.35);
}
/* QComboBox */
QComboBox {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 6px 35px;
    color: white;
}
/* Dropdown arrow area */
QComboBox::drop-down {
    border: none;
}
/* Dropdown list */
QComboBox QAbstractItemView {
    background-color: rgb(30, 120, 190);
    selection-background-color: rgb(50, 150, 220);
    color: white;
    border: none;
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    color: white;
}
QComboBox QAbstractItemView::item:selected {
    background-color: rgb(50, 150, 220);
}


QWidget#profileCard {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 16px;
}



QWidget#avatarCircle {
    background-color: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 30px;
}


QLabel#usernameLabel {
    font-size: 17px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.95);
    background: transparent;
    border: none;
}

QLabel#emailLabel {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

QFrame#divider {
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
    max-height: 1px;
}

QPushButton#logoutButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.9);
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding: 12px;
}

QPushButton#logoutButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
	color: rgba(255, 100, 100, 0.9);
}</string>

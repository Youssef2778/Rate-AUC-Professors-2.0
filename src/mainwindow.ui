       <property name="styleSheet">
        <string notr="true">/* MADE BY AI */

QLabel#summaryLabel {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    background-color: transparent;
    padding: 2px;
}

QWidget#page_2, #scrollAreaWidgetContents {
    background-color: #006FB8;
}

/* ── Professor card ── */
QWidget#widget {
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    min-width: 500px;
    max-width: 900px;
    min-height: 150px;  
    max-height: 200px;   
    background-color: rgba(28, 57, 142, 0.55);
}

/* ── Comment, AI Summary, other cards ── */
QWidget#widget_4, #widget_5, #widget_7 {
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    min-width: 500px;
    max-width: 1500px;
    min-height: 400px;
    max-height: 1000px;
    background-color: rgba(28, 57, 142, 0.55);
}

QWidget#widget_5 {
    background-color: rgba(22, 37, 86, 0.65);
    border: 1.5px solid rgba(255, 255, 255, 0.15);
	min-height: 200px
}

/* ── Labels ── */
QLabel#professorName, #studentCommentsLabel {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 30px;
    font-weight: bold;
    color: white;
}

QLabel#courseName {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 15px;
    color: #BEDBFF;
}

QLabel#addYourComment, #selectFlair, #aiLabel, #label_4 {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 17px;
    font-weight: bold;
    color: white;
}

QLabel#label_6 {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.75);
}

/* ── Comment text input ── */
QLineEdit#commentLineEdit, QTextEdit#commentLineEdit {
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 14px;
    background-color: rgba(25, 60, 184, 0.45);
    color: white;
    padding: 8px;
    font-size: 13px;
}

QLineEdit#commentLineEdit:focus, QTextEdit#commentLineEdit:focus {
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    background-color: rgba(25, 60, 184, 0.65);
}

/* ── Flair buttons ── */
QPushButton#recommendFlair, #avoidFlair, #mehFlair, #highWorkLoadFlair, #fastPacedFlair, #easyAFlair {
    color: white;
    border: 1.5px solid rgba(0, 0,0 , 0.3);
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton#recommendFlair {
    background-color: rgba(0, 200, 0, 0.3);
}

QPushButton#recommendFlair::hover {
	background-color: rgba(0, 200, 0, 1)
}

QPushButton#recommendFlair::checked{
	background-color: rgba(0, 200, 0, 1)
}

QPushButton#avoidFlair {
    background-color: rgba(200, 0, 0, 0.3);
}

QPushButton#avoidFlair::hover {
	background-color: rgba(200, 0, 0, 1)
}

QPushButton#avoidFlair::checked {
	background-color: rgba(200, 0, 0, 1)
}

QPushButton#mehFlair {
    background-color: rgba(255, 255, 255, 0.3);
    color: white;
}

QPushButton#mehFlair::hover {
	background-color: rgba(135, 206, 235, 1);
}

QPushButton#mehFlair::checked {
	background-color: rgba(135, 206, 235, 1);
}

QPushButton#fastPacedFlair {
    background-color: rgba(255, 140, 0, 0.3);
}

QPushButton#fastPacedFlair:hover {
    background-color: rgba(255, 140, 0, 1);
}

QPushButton#fastPacedFlair:checked {
    background-color: rgba(255, 140, 0, 1);
}

QPushButton#highWorkLoadFlair {
    background-color: rgba(200, 0, 0, 0.3);
}

QPushButton#highWorkLoadFlair:hover {
    background-color: rgba(200, 0, 0, 1);
}

QPushButton#highWorkLoadFlair:checked {
    background-color: rgba(200, 0, 0, 1);
}

QPushButton#easyAFlair {
    background-color: rgba(0, 180, 0, 0.3);
}

QPushButton#easyAFlair:hover {
    background-color: rgba(0, 180, 0, 1);
}

QPushButton#easyAFlair:checked {
    background-color: rgba(0, 180, 0, 1);
}

/* ── Post comment button ── */
QPushButton#postComment {
    background-color: rgba(52, 152, 219, 0.4);
    color: white;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: bold;
}

/* ── Hover &amp; press states (all buttons) ── */
QPushButton#postComment:hover {
    background-color: rgba(41, 128, 185, 0.7);
    border-color: rgba(255, 255, 255, 0.55);
}

QPushButton#postComment:pressed {
    background-color: rgba(28, 89, 128, 0.75);
}

/* ── Scrollbar styling ── */
QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.05);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* QPushButton */
QPushButton {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    color: white;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.5);
}
QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.35);
}




QWidget#profileCard_2 {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 16px;
}

QWidget#avatarCircle_2 {
    background-color: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 30px;
}

QLabel#usernameLabel_2 {
    font-size: 15px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.95);
    background: transparent;
    border: none;
}

QLabel#emailLabel_2 {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

QFrame#divider_2 {
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
    max-height: 1px;
}

QPushButton#logoutButton_2 {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.9);
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding: 12px;
}

QPushButton#logoutButton_2:hover {
    color: rgba(255, 100, 100, 0.9);
    background-color: rgba(255, 255, 255, 0.1);
}</string>

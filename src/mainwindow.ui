      <widget class="QWidget" name="page">
       <property name="styleSheet">
        <string notr="true">/* QPushButton */
QPushButton#BackToHomepage {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    color: white;
}
QPushButton#BackToHomepage:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.5);
}
QPushButton#BackToHomepage:pressed {
    background-color: rgba(255, 255, 255, 0.35);
}
QWidget#page {
    background-color: #006FB8;
}

QLabel#CourseName {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 30px;
    font-weight: bold;
    color: white;
}






QWidget#profileCard_3 {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 16px;
}

QWidget#avatarCircle_3 {
    background-color: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 30px;
}

QLabel#usernameLabel_3 {
    font-size: 17px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.95);
    background: transparent;
    border: none;
}

QLabel#emailLabel_3 {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

QFrame#divider_3 {
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
    max-height: 1px;
}

QPushButton#logoutButton_3 {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.9);
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding: 12px;
}

QPushButton#logoutButton_3:hover {
    background-color: rgba(255, 255, 255, 0.1);
	color: rgba(255, 100, 100, 0.9);
}</string>

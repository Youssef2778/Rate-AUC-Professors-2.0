BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100

# Braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: false
  BeforeElse: false

# Pointers and references
PointerAlignment: Left        # int* ptr
ReferenceAlignment: Left      # int& ref

# Includes — be careful with Qt
SortIncludes: CaseSensitive   # safer than true, respects Qt header order
IncludeBlocks: Regroup        # groups includes: Qt, then stdlib, then local

# Functions and lines
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakTemplateDeclarations: Yes  # template<> on its own line

# Spacing
SpaceBeforeParens: ControlStatements  # if (...) not if(...)
SpacesInParentheses: false
Cpp11BracedListStyle: true

# Qt specific — don't align signal/slot declarations weirdly
AlignConsecutiveDeclarations: None